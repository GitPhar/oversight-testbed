{"id":"h021","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? The capital of Kazakhstan is Astana.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Astana is the capital of Kazakhstan.","confidence":0.98,"lean":1,"theta":1.5394,"phi":0.1166},{"text":"The government, parliament, and presidential administration are based in Astana.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.1066},{"text":"Astana has been the capital since 1997.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.1507},{"text":"Astana was renamed Nur-Sultan in 2019 and changed back to Astana in September 2022, so Astana is the current official name.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.1191},{"text":"Almaty is the largest city and was the capital until 1997.","confidence":0.95,"lean":0.0,"theta":1.4923,"phi":0.7024},{"text":"Almaty is often mistaken for the capital.","confidence":0.8,"lean":-1,"theta":1.2566,"phi":2.268},{"text":"The 2019-2022 Nur-Sultan name could make the name Astana look outdated to some readers.","confidence":0.4,"lean":-1,"theta":0.6283,"phi":3.0241},{"text":"Almaty's size and history do not make it the capital today.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.286},{"text":"The renaming changed only the city's name, not its status as capital.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.1103}],"relations":[{"i":0,"j":1,"J":0.7,"relation":"supports"},{"i":0,"j":2,"J":0.7,"relation":"supports"},{"i":0,"j":3,"J":0.6,"relation":"supports"},{"i":0,"j":7,"J":0.6,"relation":"supports"},{"i":0,"j":8,"J":0.5,"relation":"supports"},{"i":1,"j":2,"J":0.5,"relation":"supports"},{"i":1,"j":3,"J":0.4,"relation":"supports"},{"i":1,"j":7,"J":0.4,"relation":"supports"},{"i":1,"j":8,"J":0.3,"relation":"supports"},{"i":2,"j":3,"J":0.4,"relation":"supports"},{"i":2,"j":4,"J":0.3,"relation":"supports"},{"i":2,"j":7,"J":0.5,"relation":"support