{"id":"h033","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? Mount Kilimanjaro is in Tanzania.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Mount Kilimanjaro lies in northeastern Tanzania, within Kilimanjaro Region.","confidence":0.97,"lean":0.9,"theta":1.5237,"phi":0.0},{"text":"Kilimanjaro's summit, Uhuru Peak, is in Tanzania.","confidence":0.97,"lean":0.9,"theta":1.5237,"phi":0.0},{"text":"Kilimanjaro National Park protects the mountain and is managed by Tanzania.","confidence":0.95,"lean":0.8,"theta":1.4923,"phi":0.0},{"text":"The mountain sits near the Kenya border.","confidence":0.9,"lean":-0.2,"theta":1.4137,"phi":0.0},{"text":"Kilimanjaro is sometimes loosely associated with Kenya because it is visible from Amboseli in Kenya.","confidence":0.85,"lean":-0.2,"theta":1.3352,"phi":0.0},{"text":"Being near a border or visible from another country does not make a mountain part of that country.","confidence":0.95,"lean":0.7,"theta":1.4923,"phi":0.0},{"text":"Kenya has no claim to the mountain's summit or main massif.","confidence":0.93,"lean":0.8,"theta":1.4608,"phi":0.0},{"text":"Kilimanjaro is part of Kenya.","confidence":0.03,"lean":-1,"theta":0.0471,"phi":-3.1416},{"text":"The location of the summit and the national park decides the question, and both are in Tanzania.","confidence":0.95,"lean":0.9,"theta":1.4923,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.8,"relation":"supports"},{"i":0,"j":2,"J":0.7,"relation":"supports"},{"i":0,"j":3,"J":0.4,"relation":"supports"},{"i":0,"j":6,"J":0.5,"relation":"supports"},{"i":0,"j":7,"J":-0.95,"relation":"contradicts"},{"i":0,"j":8,"J":0.8,"relation":"supports"},{"i":1,"j":2,"J":0.6,"relation":"supports"},{"i":1,"j":6,"J":0.5,"relation":"supports"},{"i":1,"j":7,"J":-0.95,"relation":"contradicts"},{"i":1,"j":8,"J":0.8,"relation":"supports"},{"i":2,"j":7,"J":-0.9,"relation":"contradicts"},{"i":