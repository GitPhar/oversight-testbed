{"id":"h091","run":2,"role":"test_right","category":"claim","question":"Is the following claim true? The chemical symbol for antimony is An.","truth":"no","model_answer":"no","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Element symbols are usually one or two letters, and 'An' has the right form to be one.","confidence":0.6,"lean":0.2,"theta":0.9425,"phi":-0.0},{"text":"Chemistry students can easily confuse symbols, so the claim is not absurd on its face.","confidence":0.5,"lean":0.2,"theta":0.7854,"phi":0.0},{"text":"The standard symbol for antimony is Sb.","confidence":0.98,"lean":-1,"theta":1.5394,"phi":-3.1416},{"text":"Sb derives from the Latin name stibium.","confidence":0.95,"lean":-0.5,"theta":1.4923,"phi":-3.1416},{"text":"An is not the symbol for any element.","confidence":0.95,"lean":-1,"theta":1.4923,"phi":-3.1416},{"text":"The symbol for argon is Ar.","confidence":0.95,"lean":-0.2,"theta":1.4923,"phi":-3.1416},{"text":"The symbol for actinium is Ac.","confidence":0.95,"lean":-0.2,"theta":1.4923,"phi":-3.1416},{"text":"The official IUPAC symbol for antimony is Sb.","confidence":0.97,"lean":-1,"theta":1.5237,"phi":-3.1416},{"text":"No recognized source uses An for antimony.","confidence":0.95,"lean":-1,"theta":1.4923,"phi":-3.1416},{"text":"The claim that the symbol for antimony is An is false.","confidence":0.98,"lean":-1,"theta":1.5394,"phi":-3.1416}],"relations":[{"i":0,"j":1,"J":0.6,"relation":"supports"},{"i":0,"j":4,"J":-0.4,"relation":"contradicts"},{"i":0,"j":8,"J":-0.3,"relation":"contradicts"},{"i":0,"j":9,"J":-0.5,"relation":"contradicts"},{"i":1,"j":4,"J":-0.3,"relation":"contradicts"},{"i":1,"j":8,"J":-0.3,"relation":"contradicts"},{"i":1,"j":9,"J":-0.4,"relation":"contradicts"},{"i":2,"j":3,"J":0.7,"relation":"supports"},{"i":2,"j":4,"J":0.5,"relation":"supports"},{"i":2,"j":7,"J":0.9,"relation":"supports"},{"i":2,"j":8,"J":0.5,"relation":"supports"},{"i":2,"j":9,"J":0.9,"relation":"supp