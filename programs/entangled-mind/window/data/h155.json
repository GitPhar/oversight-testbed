{"id":"h155","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? Saturn's largest moon is Titan.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Titan is the largest of Saturn's moons.","confidence":0.98,"lean":1,"theta":1.5394,"phi":0.1856},{"text":"Titan has a diameter of about 5,150 km.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Titan is the second-largest moon in the Solar System after Ganymede.","confidence":0.95,"lean":0.0,"theta":1.4923,"phi":1.1596},{"text":"Titan is larger than Saturn's next-largest moon, Rhea, by a wide margin.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.2219},{"text":"Titan is larger in diameter than Mercury but less massive.","confidence":0.9,"lean":0.0,"theta":1.4137,"phi":0.0},{"text":"Titan is not the largest moon in the Solar System, since Ganymede is.","confidence":0.95,"lean":-1,"theta":1.4923,"phi":1.7514},{"text":"Ganymede's greater size does not make the claim false because the claim concerns only Saturn's moons.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.4516},{"text":"There are no substantive considerations against the claim.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.1432}],"relations":[{"i":0,"j":3,"J":0.6,"relation":"supports"},{"i":0,"j":6,"J":0.7,"relation":"supports"},{"i":0,"j":7,"J":0.5,"relation":"supports"},{"i":1,"j":4,"J":0.3,"relation":"supports"},{"i":2,"j":3,"J":0.3,"relation":"supports"},{"i":2,"j":5,"J":0.9,"relation":"supports"},{"i":2,"j":6,"J":0.4,"relation":"supports"},{"i":5,"j":6,"J":0.5,"relation":"supports"},{"i":6,"j":7,"J":0.4,"relation":"supports"}],"readout_weights":[0.1667,0.1667,0.0,0.1667,0.0,0.1667,0.1667,0.1667],"stages":[{"stage":"encode","qubits":[{"amp":0.9995,"phase":0.1856,"p_yes":0.9912,"bloch":[0.9823,0.1845,0.0314],"purity":1.0},{"amp":0.9877,"phase":0.0,"p_yes":0.9938,"bloch":[0.9877,0.0,0.1564],"purity":1.0},{"amp":0.996