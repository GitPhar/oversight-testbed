{"id":"h182","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? The atomic number of gold is 79.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Gold's chemical symbol is Au, from the Latin aurum.","confidence":0.97,"lean":0.2,"theta":1.5237,"phi":0.0},{"text":"Gold's atomic number, the proton count per nucleus, is 79.","confidence":0.99,"lean":1,"theta":1.5551,"phi":0.0},{"text":"The value 79 is standard in the periodic table.","confidence":0.97,"lean":0.9,"theta":1.5237,"phi":0.0},{"text":"Gold's position in group 11 and period 6 is consistent with atomic number 79.","confidence":0.9,"lean":0.7,"theta":1.4137,"phi":0.0},{"text":"Gold has several isotopes with varying neutron counts.","confidence":0.95,"lean":-0.1,"theta":1.4923,"phi":0.0},{"text":"Isotopes do not change the atomic number because the proton number is fixed for the element.","confidence":0.97,"lean":0.8,"theta":1.5237,"phi":0.0},{"text":"No credible source gives a different atomic number for gold.","confidence":0.95,"lean":0.9,"theta":1.4923,"phi":0.0},{"text":"The definition of atomic number plus the periodic table entry settles the matter, so the claim is true.","confidence":0.98,"lean":1,"theta":1.5394,"phi":0.0}],"relations":[{"i":1,"j":2,"J":0.9,"relation":"supports"},{"i":1,"j":3,"J":0.8,"relation":"supports"},{"i":1,"j":5,"J":0.5,"relation":"supports"},{"i":1,"j":6,"J":0.7,"relation":"supports"},{"i":1,"j":7,"J":0.8,"relation":"supports"},{"i":2,"j":3,"J":0.6,"relation":"supports"},{"i":2,"j":6,"J":0.6,"relation":"supports"},{"i":2,"j":7,"J":0.6,"relation":"supports"},{"i":3,"j":6,"J":0.5,"relation":"supports"},{"i":3,"j":7,"J":0.6,"relation":"supports"},{"i":4,"j":5,"J":0.5,"relation":"supports"},{"i":5,"j":6,"J":0.4,"relation":"supports"},{"i":5,"j":7,"J":0.4,"relation":"supports"},{"i":6,"j":7,"J":0.6,"relation":"supports"}],"readout_weights":[0.0357,0.1786,0.1607,