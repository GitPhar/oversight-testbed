{"id":"h183","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? Saturn's largest moon is Enceladus.","truth":"no","model_answer":"no","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Enceladus is one of Saturn's most studied moons.","confidence":0.9,"lean":0.2,"theta":1.4137,"phi":0.0},{"text":"Enceladus has a bright, reflective icy surface, water geysers at its south pole, and a subsurface ocean.","confidence":0.9,"lean":0.1,"theta":1.4137,"phi":0.0},{"text":"Enceladus's prominence could lead people to wrongly assume it is the largest moon.","confidence":0.6,"lean":0.2,"theta":0.9425,"phi":3.1416},{"text":"Enceladus is small, with a diameter of about 504 km.","confidence":0.95,"lean":-0.8,"theta":1.4923,"phi":3.1416},{"text":"Titan is Saturn's largest moon, with a diameter of about 5,150 km.","confidence":0.97,"lean":-1,"theta":1.5237,"phi":3.1416},{"text":"Titan is the second-largest moon in the Solar System after Ganymede.","confidence":0.9,"lean":-0.3,"theta":1.4137,"phi":3.1416},{"text":"Titan is more massive than all of Saturn's other moons combined and has a thick atmosphere.","confidence":0.9,"lean":-0.6,"theta":1.4137,"phi":3.1416},{"text":"Direct size measurements settle which moon is largest.","confidence":0.9,"lean":-0.3,"theta":1.4137,"phi":3.1416},{"text":"Enceladus is Saturn's largest moon.","confidence":0.02,"lean":1,"theta":0.0314,"phi":-0.0}],"relations":[{"i":2,"j":3,"J":0.5,"relation":"supports"},{"i":2,"j":4,"J":0.5,"relation":"supports"},{"i":2,"j":8,"J":-0.8,"relation":"contradicts"},{"i":3,"j":8,"J":-0.9,"relation":"contradicts"},{"i":4,"j":5,"J":0.5,"relation":"supports"},{"i":4,"j":6,"J":0.4,"relation":"supports"},{"i":4,"j":7,"J":0.6,"relation":"supports"},{"i":4,"j":8,"J":-0.95,"relation":"contradicts"},{"i":5,"j":8,"J":-0.8,"relation":"contradicts"},{"i":6,"j":8,"J":-0.5,"relation":"contradicts"},{"i":7,"j":8,"J":-0.6,"relation":"contradicts"}],"rea