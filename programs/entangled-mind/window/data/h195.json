{"id":"h195","run":2,"role":"calibration","category":"claim","question":"Is the following claim true? Marie Curie was born in Warsaw.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"Marie Curie was born on 7 November 1867 in Warsaw.","confidence":0.97,"lean":1,"theta":1.5237,"phi":0.4764},{"text":"Warsaw was then part of the Russian Empire's Congress Poland.","confidence":0.95,"lean":0.0,"theta":1.4923,"phi":1.6016},{"text":"Biographical records, including her own accounts and standard biographies, consistently give Warsaw as her birthplace.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.4888},{"text":"Warsaw was not an independent state in 1867, so 'born in Warsaw' could be misread as implying a sovereign Polish birthplace.","confidence":0.8,"lean":-1,"theta":1.2566,"phi":2.1138},{"text":"Her birth city was under Russian administration, so some sources describe her nationality differently.","confidence":0.7,"lean":-1,"theta":1.0996,"phi":2.0464},{"text":"The political complications do not make the claim false because the city is named correctly.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.9497},{"text":"Political context affects only how the country is described, not the city.","confidence":0.9,"lean":1,"theta":1.4137,"phi":-0.7208},{"text":"The claim that Marie Curie was born in Warsaw is true.","confidence":0.97,"lean":1,"theta":1.5237,"phi":0.7258}],"relations":[{"i":0,"j":2,"J":0.7,"relation":"supports"},{"i":0,"j":5,"J":0.5,"relation":"supports"},{"i":0,"j":7,"J":0.9,"relation":"supports"},{"i":1,"j":3,"J":0.4,"relation":"supports"},{"i":1,"j":4,"J":0.5,"relation":"supports"},{"i":1,"j":5,"J":0.4,"relation":"supports"},{"i":1,"j":6,"J":-0.4,"relation":"contradicts"},{"i":1,"j":7,"J":0.6,"relation":"supports"},{"i":2,"j":5,"J":0.6,"relation":"supports"},{"i":2,"j":7,"J":0.9,"relation":"supports"},{"i":3,"j":4,"J":0.3,"relation":"supports"},{"i":3,"j":5,"J":0.4,"r