{"id":"h300","run":2,"role":"test_right","category":"claim","question":"Is the following claim true? The speed of sound in dry air at 20 °C is about 343 metres per second.","truth":"yes","model_answer":"yes","correct":true,"source":"author-written for this project; verified by the author","claims":[{"text":"The speed of sound in dry air at 20 °C is about 343 m/s.","confidence":0.97,"lean":1,"theta":1.5237,"phi":0.0},{"text":"The speed of sound in air is about 331.3 m/s at 0 °C.","confidence":0.92,"lean":1,"theta":1.4451,"phi":0.0},{"text":"The speed of sound rises by about 0.6 m/s per degree Celsius.","confidence":0.92,"lean":1,"theta":1.4451,"phi":0.0},{"text":"The formula v ≈ 331.3 + 0.606·T gives about 343.4 m/s at 20 °C, matching the claim.","confidence":0.93,"lean":1,"theta":1.4608,"phi":0.0},{"text":"The standard value of the speed of sound in air is well established.","confidence":0.93,"lean":1,"theta":1.4608,"phi":0.0},{"text":"Humid air carries sound slightly faster, but this does not affect the claim because the question specifies dry air.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Sound speed depends on humidity and pressure, which could threaten the claim.","confidence":0.15,"lean":-1,"theta":0.2356,"phi":-3.1416},{"text":"The word 'about' allows small variation, but 343 m/s is within the normal precision of the accepted value.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Standard formulas and tabulated values both give about 343 m/s, so the claim matches the accepted value.","confidence":0.93,"lean":1,"theta":1.4608,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.4,"relation":"supports"},{"i":0,"j":2,"J":0.3,"relation":"supports"},{"i":0,"j":3,"J":0.9,"relation":"supports"},{"i":0,"j":4,"J":0.5,"relation":"supports"},{"i":0,"j":5,"J":0.3,"relation":"supports"},{"i":0,"j":6,"J":-0.3,"relation":"contradicts"},{"i":0,"j":7,"J":0.6,"relation":"supports"},{"i":0,"j":8,"J":0.9,"relation":"supports"},{"i":1,"j":2,"J":0.5,"relati