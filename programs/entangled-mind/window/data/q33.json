{"id":"q33","run":1,"role":"calibration","category":"math","question":"Is 2^31 - 1 a prime number?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"2^31 − 1 = 2,147,483,647 is prime.","confidence":0.99,"lean":1,"theta":1.5551,"phi":0.0717},{"text":"2^31 − 1 is a Mersenne number with prime exponent 31, and a prime exponent is necessary for primality.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.2338},{"text":"2^31 − 1 appears in the standard list of Mersenne primes.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.062},{"text":"The Lucas–Lehmer test confirms that 2^31 − 1 is prime.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0716},{"text":"Euler proved in 1772 that 2^31 − 1 has no prime factor.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0687},{"text":"2^31 − 1 is widely used in practice, e.g. as the modulus in the Park–Miller random number generator.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0205},{"text":"A prime exponent does not guarantee primality; for example 2^11 − 1 = 2047 = 23 × 89 and 2^23 − 1 is composite.","confidence":0.95,"lean":-1,"theta":1.4923,"phi":0.7811},{"text":"A direct divisor check up to about 46,341 would be tedious by hand.","confidence":0.9,"lean":0.0,"theta":1.4137,"phi":0.179},{"text":"The prime exponent alone is not enough to decide primality; Lucas–Lehmer and Euler's proof decide it.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.179}],"relations":[{"i":0,"j":1,"J":0.3,"relation":"supports"},{"i":0,"j":2,"J":0.8,"relation":"supports"},{"i":0,"j":3,"J":0.9,"relation":"supports"},{"i":0,"j":4,"J":0.7,"relation":"supports"},{"i":0,"j":5,"J":0.4,"relation":"supports"},{"i":0,"j":8,"J":0.5,"relation":"supports"},{"i":1,"j":2,"J":0.3,"relation":"supports"},{"i":1,"j":6,"J":0.7,"relation":"supports"},{"i":1,"j":8,"J":0.6,"relation":"supports"},{"i":2,"j":3,"J":0.3,"relation":"supports"},{"i":3,"j":4,"J":0.2,"relation":"supports"},{"i":3,"j":8,"J":0.7,"relation":"supports"},{"i"