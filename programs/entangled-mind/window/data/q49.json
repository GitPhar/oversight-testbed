{"id":"q49","run":1,"role":"calibration","category":"fact","question":"Is Rome farther north than New York City?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"Rome is at about 41.9°N latitude.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"New York City is at about 40.7°N latitude.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Rome is roughly 130 km (80 miles) farther north than New York City.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Rome is farther north than New York City.","confidence":0.97,"lean":1,"theta":1.5237,"phi":0.0},{"text":"Rome lies on roughly the same parallel as northern Spain and well above North Africa's Mediterranean coast, consistent with its northern position.","confidence":0.8,"lean":1,"theta":1.2566,"phi":0.0},{"text":"Rome is far east of New York (about 12°E versus 74°W), which could cause confusion.","confidence":0.9,"lean":0.0,"theta":1.4137,"phi":0.0},{"text":"East-west position does not affect which city is farther north.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Time zones or climate comparisons could mislead but do not change the latitude comparison.","confidence":0.85,"lean":0.0,"theta":1.3352,"phi":0.0},{"text":"Nothing substantive argues against Rome being farther north.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Rome's roughly 1.2° higher latitude is a clear, verifiable difference that alone settles the question.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.8,"relation":"supports"},{"i":0,"j":2,"J":0.9,"relation":"supports"},{"i":0,"j":3,"J":0.9,"relation":"supports"},{"i":0,"j":4,"J":0.6,"relation":"supports"},{"i":0,"j":8,"J":0.5,"relation":"supports"},{"i":0,"j":9,"J":0.7,"relation":"supports"},{"i":1,"j":2,"J":0.7,"relation":"supports"},{"i":1,"j":3,"J":0.8,"relation":"supports"},{"i":1,"j":4,"J":0.4,"relation":"supports"},{"i":1,"j":8,"J":0.5,"relation":"s