{"id":"q50","run":1,"role":"calibration","category":"fact","question":"Is the Atlantic entrance of the Panama Canal farther west than its Pacific entrance?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"The Atlantic entrance at Colón lies at about 79°54′W.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"The Pacific entrance at Balboa lies at about 79°34′W.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"The canal runs roughly northwest to southeast.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"The Atlantic end is the northwestern end and sits farther west.","confidence":0.92,"lean":1,"theta":1.4451,"phi":0.0},{"text":"Intuition says the canal crosses the isthmus east to west, which would put the Atlantic entrance east.","confidence":0.2,"lean":-1,"theta":0.3142,"phi":-3.1416},{"text":"The east-to-west intuition holds only loosely.","confidence":0.85,"lean":1,"theta":1.3352,"phi":0.0},{"text":"The isthmus as a whole trends northwest to southeast and the canal follows it.","confidence":0.88,"lean":1,"theta":1.3823,"phi":0.0},{"text":"The Pacific end ends up east of the Atlantic end.","confidence":0.92,"lean":1,"theta":1.4451,"phi":0.0},{"text":"The coordinates settle the matter.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.9,"relation":"supports"},{"i":0,"j":2,"J":0.4,"relation":"supports"},{"i":0,"j":3,"J":0.9,"relation":"supports"},{"i":0,"j":4,"J":-0.9,"relation":"contradicts"},{"i":0,"j":6,"J":0.4,"relation":"supports"},{"i":0,"j":7,"J":0.9,"relation":"supports"},{"i":0,"j":8,"J":0.7,"relation":"supports"},{"i":1,"j":2,"J":0.4,"relation":"supports"},{"i":1,"j":3,"J":0.8,"relation":"supports"},{"i":1,"j":4,"J":-0.8,"relation":"contradicts"},{"i":1,"j":6,"J":0.4,"relation":"supports"},{"i":1,"j":7,"J":0.8,"relation":"supports"},{"i":1,"j":8,"J":0.7,"relation":"supports"},{"i":2,"j":3,"J":0.7,"relation":"supports"},{"i":2,"j":4,"J":-0.5,"relati