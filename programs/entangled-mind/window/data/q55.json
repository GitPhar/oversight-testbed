{"id":"q55","run":1,"role":"calibration","category":"fact","question":"Is a day on Venus (one full rotation relative to the stars) longer than a year on Venus?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"Venus's sidereal rotation period is about 243.0 Earth days.","confidence":0.98,"lean":1,"theta":1.5394,"phi":0.0},{"text":"Venus's orbital period is about 224.7 Earth days.","confidence":0.98,"lean":1,"theta":1.5394,"phi":0.0},{"text":"The rotation period exceeds the orbital period by roughly 18 Earth days.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Venus rotates retrograde, but the magnitude of its rotation period is still about 243 days.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"The solar day on Venus is only about 116.75 Earth days, shorter than its year.","confidence":0.9,"lean":-1,"theta":1.4137,"phi":-3.1416},{"text":"The solar-day comparison answers a different question and doesn't decide this one.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Venus's synodic period of about 584 days is a different quantity and irrelevant to the sidereal comparison.","confidence":0.9,"lean":0.0,"theta":1.4137,"phi":0.0},{"text":"The question defines a day as one rotation relative to the stars, so the sidereal rotation period is the relevant measure.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.5,"relation":"supports"},{"i":0,"j":2,"J":0.8,"relation":"supports"},{"i":0,"j":3,"J":0.7,"relation":"supports"},{"i":0,"j":7,"J":0.8,"relation":"supports"},{"i":1,"j":2,"J":0.8,"relation":"supports"},{"i":2,"j":3,"J":0.6,"relation":"supports"},{"i":2,"j":7,"J":0.5,"relation":"supports"},{"i":3,"j":7,"J":0.6,"relation":"supports"},{"i":4,"j":5,"J":-0.5,"relation":"contradicts"},{"i":4,"j":7,"J":-0.7,"relation":"contradicts"},{"i":5,"j":7,"J":0.5,"relation":"supports"},{"i":6,"j":7,"J":0.4,"relation":"supports"}],"readout_weights":[0.1429,0.1429,0.1429