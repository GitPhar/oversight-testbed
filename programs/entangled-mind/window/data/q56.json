{"id":"q56","run":1,"role":"calibration","category":"fact","question":"Is the Pacific Ocean larger in area than all of Earth's land area combined?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"The Pacific Ocean covers about 165 million km².","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Earth's total land area is about 149 million km².","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"The Pacific is roughly 30% of Earth's surface while land is roughly 29%.","confidence":0.8,"lean":1,"theta":1.2566,"phi":0.0},{"text":"Reported Pacific figures consistently fall around 165 to 168 million km², with the higher figure including marginal seas.","confidence":0.85,"lean":1,"theta":1.3352,"phi":0.0},{"text":"The roughly 16 million km² gap is larger than the disagreement between estimates.","confidence":0.85,"lean":1,"theta":1.3352,"phi":0.0},{"text":"Definitions of the Pacific differ, and excluding marginal seas could change its area.","confidence":0.4,"lean":-1,"theta":0.6283,"phi":-3.1416},{"text":"Land area figures depend on how coastlines, ice sheets, and inland waters are counted, adding uncertainty.","confidence":0.4,"lean":-1,"theta":0.6283,"phi":-3.1416},{"text":"The definitional uncertainties are small compared with the gap, so even the smallest Pacific figure and largest land figure leave the ocean ahead.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"The Pacific Ocean is larger than all of Earth's land combined.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.7,"relation":"supports"},{"i":0,"j":2,"J":0.5,"relation":"supports"},{"i":0,"j":3,"J":0.6,"relation":"supports"},{"i":0,"j":4,"J":0.5,"relation":"supports"},{"i":0,"j":7,"J":0.6,"relation":"supports"},{"i":0,"j":8,"J":0.9,"relation":"supports"},{"i":1,"j":2,"J":0.5,"relation":"supports"},{"i":1,"j":7,"J":0.6,"relation":"supports"},{"i":1,"j":8,"J":0.8,"relation":"supports"},{"i":2,"j":7,"J":