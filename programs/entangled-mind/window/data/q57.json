{"id":"q57","run":1,"role":"calibration","category":"fact","question":"Did Cleopatra live closer in time to the first Moon landing than to the construction of the Great Pyramid of Giza?","truth":"yes","model_answer":"yes","correct":true,"source":null,"claims":[{"text":"Cleopatra VII died in 30 BCE.","confidence":0.97,"lean":0.0,"theta":1.5237,"phi":0.0},{"text":"The first Moon landing occurred in July 1969 CE.","confidence":0.99,"lean":0.0,"theta":1.5551,"phi":0.0},{"text":"The gap between Cleopatra's death and the Moon landing is about 1,999 years.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"The Great Pyramid was built around 2560 BCE, about 2,530 years before Cleopatra's death.","confidence":0.95,"lean":1,"theta":1.4923,"phi":0.0},{"text":"Using her birth (69 BCE) or reign start (51 BCE) does not change the result; she is still closer to 1969.","confidence":0.93,"lean":1,"theta":1.4608,"phi":0.0},{"text":"Popular culture treats ancient Egypt as one period, making Cleopatra and the pyramids seem close, but this intuition is wrong.","confidence":0.9,"lean":1,"theta":1.4137,"phi":0.0},{"text":"Uncertainty in the pyramid's date is small and no plausible date brings it within 2,000 years of Cleopatra.","confidence":0.92,"lean":1,"theta":1.4451,"phi":0.0},{"text":"Cleopatra lived closer in time to the Moon landing than to the pyramid's construction, by roughly 500 years.","confidence":0.97,"lean":1,"theta":1.5237,"phi":0.0}],"relations":[{"i":0,"j":1,"J":0.4,"relation":"supports"},{"i":0,"j":2,"J":0.7,"relation":"supports"},{"i":0,"j":3,"J":0.7,"relation":"supports"},{"i":0,"j":4,"J":0.6,"relation":"supports"},{"i":0,"j":6,"J":0.4,"relation":"supports"},{"i":0,"j":7,"J":0.6,"relation":"supports"},{"i":1,"j":2,"J":0.7,"relation":"supports"},{"i":1,"j":3,"J":0.4,"relation":"supports"},{"i":1,"j":4,"J":0.5,"relation":"supports"},{"i":1,"j":6,"J":0.3,"relation":"supports"},{"i":1,"j":7,"J":0.6,"relation":"supports"},{"i":2,"j":3,"J":0.6,"relation":"suppor